# DocFlow AI — Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/public key (safe to expose to the browser — protected by RLS).
# Supabase may label this "Publishable" or "Anon" depending on dashboard version.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Alias accepted for backwards compat; use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-SIDE ONLY. Never expose to the browser.
# Required for Phase 2B+ admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Phase 2B: AI invoice extraction. Not used in Phase 2A.
# Found in: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
